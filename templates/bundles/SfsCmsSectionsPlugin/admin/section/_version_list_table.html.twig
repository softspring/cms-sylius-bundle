{% set backSection = backSection|default('versions') %}

{% block table %}
    {% embed '@SfsComponents/paginator/table.html.twig' with {
        'collection': versions,
        'filter_form': null,
        'pagination_route': 'sfs_cms_admin_sections_versions',
        'pagination_route_attributes': {'section':section.id},
        'table_class': 'ui celled table',
        'sfs_components_theme': sfs_components_theme|default('semantic-ui'),
    } %}
        {% trans_default_domain 'sfs_cms_admin' %}
        {% block ths %}
            <th>{{ ('admin_sections.versions.fields.id.header')|trans }}</th>
            <th>{{ ('admin_sections.versions.fields.origin.header')|trans }}</th>
            <th>{{ ('admin_sections.versions.fields.note.header')|trans }}</th>
            <th>{{ ('admin_sections.versions.fields.creator.header')|trans }}</th>
            <th>{{ ('admin_sections.versions.fields.created.header')|trans }}</th>
            <th>{{ ('admin_sections.versions.fields.publish_status.header')|trans }}</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        {% endblock ths %}

        {% block tds %}
            {% set version = version|default(entity|default(element)) %}

            <td>v{{ version.versionNumber }} {% if version.hasCompileErrors %}<i
                        class="exclamation triangle icon red"
                        title="This version has some compilation error"></i>{% endif %}</td>
            <td>{{ ('admin_sections.versions.origin.'~(version.origin|default('null')))|trans }} {{ version.originDescription ? '('~version.originDescription~')' : '' }}</td>
            <td>
                <a href="{{ url('sfs_cms_admin_sections_version_info', {'section':section.id, 'version':version.id}) }}">
                    <i class="tag icon"></i>
                    {% if version.note %}
                        {{ version.note }}
                    {% else %}
                        {{ ('admin_sections.versions.actions.add_note.link')|trans }}
                    {% endif %}
                </a>
            </td>
            <td>
                {% set creator = version.metaField('creator') %}
                {% if creator %}
                    {{ creator.name|default(creator.id)|default('') }}
                {% endif %}
            </td>
            <td>{{ version.createdAt|date('H:i:s d-m-Y') }}</td>
            <td>{{ version.published ? ('admin_sections.versions.publish_status.published')|trans : ('admin_sections.versions.publish_status.unpublished')|trans }}</td>
            <td>
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_KEEP', version) %}
                    {% if version.keep %}
                        <a href="{{ url('sfs_cms_admin_sections_unkeep_version', {'section':section.id, 'version':version.id, 'back': backSection, 'page': entities.page|default}) }}"
                           title="{{ ('admin_sections.versions.actions.keep.link')|trans }}"><i
                                    class="pin icon"></i></a>
                    {% else %}
                        <a href="{{ url('sfs_cms_admin_sections_keep_version', {'section':section.id, 'version':version.id, 'back': backSection, 'page': entities.page|default}) }}"
                           title="{{ ('admin_sections.versions.actions.nokeep.link')|trans }}"><i
                                    class="pin outline icon"></i></a>
                    {% endif %}
                {% else %}
                    {% if version.keep %}
                        <span title="{{ ('admin_sections.versions.actions.keep.link')|trans }}"><i
                                    class="pin icon"></i></span>
                    {% else %}
                        <span title="{{ ('admin_sections.versions.actions.nokeep.link')|trans }}"><i
                                    class="pin outline icon"></i></span>
                    {% endif %}
                {% endif %}
            </td>
            <td>
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_INFO', version) %}
                    <a href="{{ url('sfs_cms_admin_sections_version_info', {'section':section.id, 'version':version.id}) }}"
                       class="ui tiny button">{{ ('admin_sections.versions.actions.info.link')|trans }} <i class="info circle icon"></i></a>
                {% endif %}

                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_CREATE', version) %}
                    <a href="{{ url('sfs_cms_admin_sections_content_from_version', {'section':section.id, 'prevVersion':version.id}) }}"
                       class="ui tiny button">{{ ('admin_sections.versions.actions.edit.link')|trans }} <i class="pencil alternate icon"></i></a>
                {% endif %}

                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_PREVIEW', version) %}
                    <a href="{{ url('sfs_cms_admin_sections_preview', {'section':section.id, 'version':version.id}) }}"
                       class="ui tiny button">{{ ('admin_sections.versions.actions.preview.link')|trans }}
                        <i class="eye icon"></i></a>
                {% endif %}

                {#                {% if not section_config.admin.export_version.is_granted or is_granted(section_config.admin.export_version.is_granted, version) %} #}
                {#                    <a href="{{ url('sfs_cms_admin_sections_export_version', {'section':section.id, 'version':version.id}) }}" #}
                {#                       class="ui tiny button">{{ ('admin_sections.versions.actions.export.link')|trans }} #}
                {#                        <i class="download icon"></i></a> #}
                {#                {% endif %} #}

                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_PUBLISH', version) %}
                    {% if not version.published %}
                        <a href="{{ url('sfs_cms_admin_sections_publish_version', {'section':section.id, 'version':version.id, 'back': backSection, 'page': entities.page|default}) }}"
                                {% if version.compileErrors %}
                                    data-confirm-modal-title="{{ ('admin_sections.version_publish.with_errors_confirm_message_title')|trans }}"
                                    data-confirm-modal="{{ ('admin_sections.version_publish.with_errors_confirm_message_raw')|trans|base64_encode }}"
                                    data-confirm-modal-confirm-button-type="danger"
                                {% else %}
                                    data-confirm-modal-title="{{ ('admin_sections.version_publish.confirm_message_title')|trans }}"
                                    data-confirm-modal="{{ ('admin_sections.version_publish.confirm_message_raw')|trans|base64_encode }}"
                                {% endif %}
                           class="ui tiny button">{{ ('admin_sections.versions.actions.publish.link')|trans }}
                            <i class="file upload icon"></i></a>
                    {% endif %}
                {% endif %}
            </td>
            <td>
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_DELETE', version) %}
                    <a href="{{ url('sfs_cms_admin_sections_delete_version', {'section':section.id, 'version':version.id, 'back': backSection}) }}">
                        <i class="trash alternate outline icon grey"
                           title="This version will be removed on versions cleanup"></i>
                    </a>
                {% elseif version.deleteOnCleanup %}
                    <i class="trash alternate outline icon grey"
                       title="This version will be removed on versions cleanup"></i>
                {% endif %}
            </td>
        {% endblock tds %}
    {% endembed %}
{% endblock table %}
