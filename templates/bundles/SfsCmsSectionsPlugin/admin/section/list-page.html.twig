{% trans_default_domain 'sfs_cms_admin' %}

{% for entity in collection %}
    <tr>
        <td>{{ entity.name }}</td>
        <td>{{ "sections.status.#{entity.status}"|trans }}</td>
        <td>{{ entity.publishedVersion ? entity.publishedVersion.createdAt|date('H:i d-m-Y') : '' }}</td>
        <td class="text-end">
            <div class="ui buttons">
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_READ', entity) %}
                <a class="ui labeled icon button" href="{{ url('sfs_cms_admin_sections_details', {'section':entity.id}) }}">
                        <i class="icon search"></i>{{ ('admin_sections.list.actions.details.link')|trans }}
                {% endif %}
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_CREATE', entity) %}
                    <a class="ui labeled icon button" href="{{ url('sfs_cms_admin_sections_content', {'section':entity.id}) }}">
                        <i class="icon pencil"></i>{{ ('admin_sections.list.actions.content.link')|trans }}</a>
                {% endif %}
                {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_PREVIEW', entity) %}
                    <a class="ui labeled icon button" href="{{ url('sfs_cms_admin_sections_preview', {'section':entity.id}) }}">
                        <i class="icon eye"></i>{{ ('admin_sections.list.actions.preview.link')|trans }}</a>
                {% endif %}
            </div>
        </td>
    </tr>
{% endfor %}
