{% trans_default_domain 'sfs_cms_admin' %}

<ul class="ui top attached tabular menu" id="myTab" role="tablist">
    {% block tabs %}
        <li class="{{ current == 'read' ? 'active' : '' }} item">
            <a href="{{ url('sfs_cms_admin_routes_read', {'route':route.id}) }}" >{{ ('admin_routes.tabs_menu.details')|trans }}</a>
        </li>
        <li class="{{ current == 'update' ? 'active' : '' }} item">
            <a href="{{ url('sfs_cms_admin_routes_update', {'route':route.id}) }}" >{{ ('admin_routes.tabs_menu.update')|trans }}</a>
        </li>
    {% endblock %}
</ul>