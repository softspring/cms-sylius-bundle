{% trans_default_domain 'sfs_cms_admin' %}

{% extends '@SfsCms/admin_layout_semantic.html.twig' %}

{% form_theme form
    '@SfsCms/forms/cms_theme_semantic.html.twig'
    '@SfsCms/forms/routes_theme_semantic.html.twig'
    '@SfsCms/forms/types_theme_semantic.html.twig'
%}

{% block title %}{{ ('admin_sections.update.meta.title')|trans({'%name%':section.name}) }}{% endblock %}

{% block header_title %}{{ 'admin_sections.update.title'|trans }}{% endblock %}
{% block header_subtitle %}Manage your section{% endblock %}
{% block header_icon %}th{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <a class="section" href="{{ url('sfs_cms_admin_sections_list') }}">{{ ('admin_sections.list.breadcrumb')|trans }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section" href="{{ url('sfs_cms_admin_sections_details', {'section':section.id}) }}">{{ ('admin_sections.read.breadcrumb')|trans({'%name%': section.name}) }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section active">{{ ('admin_sections.update.breadcrumb')|trans({'%name%':section.name}) }}</a>
{% endblock breadcrums_content %}

{% block content %}
    {% include '@SfsCms/admin/section/_section_tabs.html.twig' with {'current':'update', 'section_entity':section} %}

    <div class="ui bottom attached active tab segment">
        {{ form_start(form, {'attr': {'class': 'ui form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {% if form.addLocale is defined %}{{ form_row(form.addLocale) }}{% endif %}
            {% if form.extraData is defined %}{{ form_widget(form.extraData) }}{% endif %}
            {{ form_rest(form) }}
            <div class="ui hidden divider"></div>
            <div class="ui buttons">
                <button class="ui labeled icon primary button" type="submit">
                    <i class="save icon"></i> {{ ('admin_sections.update.actions.update.button')|trans }}
                </button>
                <a href="{{ url('sfs_cms_admin_sections_details', {'section':section.id}) }}" class="ui button">
                    {{ ('admin_sections.update.actions.cancel.button')|trans }}
                </a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock content %}
