{% trans_default_domain 'sfs_cms_admin' %}

{% extends '@SfsCms/admin_layout_semantic.html.twig' %}

{% block title %}{{ ('admin_sections.version_info.meta.title')|trans({'%name%':section_entity.name, '%versionNumber%': version_entity.versionNumber}) }}{% endblock %}

{% block header_title %}{{ ('admin_sections.version_info.title')|trans({'%name%':section_entity.name, '%versionNumber%': version_entity.versionNumber}) }}{% endblock %}
{% block header_subtitle %}Manage your section{% endblock %}
{% block header_buttons %}
    {# Optionally include a header buttons partial here if available #}
{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <a class="section" href="{{ url('sfs_cms_admin_sections_list') }}">{{ ('admin_sections.list.breadcrumb')|trans }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section" href="{{ url('sfs_cms_admin_sections_details', {'section':section_entity.id}) }}">{{ ('admin_sections.read.breadcrumb')|trans({'%name%': section_entity.name}) }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section" href="{{ url('sfs_cms_admin_sections_versions', {'section':section_entity.id}) }}">{{ ('admin_sections.versions.breadcrumb')|trans({'%name%':section_entity.name}) }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section active">{{ ('admin_sections.version_info.breadcrumb')|trans({'%name%':section_entity.name, '%versionNumber%': version_entity.versionNumber}) }}</a>
{% endblock breadcrums_content %}

{% block content %}
    {% include '@SfsCms/admin/section/_section_tabs.html.twig' with {'current':'versions', 'section_entity':section_entity} %}
    <div class="ui bottom attached active tab segment">
        <div class="ui right aligned grid clearing">
            <div class="ui buttons column">
                {% block actions %}
                    {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_CREATE', version) %}
                        <a class="ui labeled icon button"
                           href="{{ url('sfs_cms_admin_sections_section_from_version', {'section':section_entity.id, 'prevVersion':version.id}) }}">{{ ('admin_sections.versions.actions.edit.link')|trans }}
                            <i class="icon pencil"></i></a>
                    {% endif %}

                    {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_PREVIEW', version) %}
                        <a class="ui labeled icon button"
                           href="{{ url('sfs_cms_admin_sections_preview', {'section':section_entity.id, 'version':version.id}) }}">{{ ('admin_sections.versions.actions.preview.link')|trans }}
                            <i class="icon eye"></i></a>
                    {% endif %}

                    {# Uncomment if export is implemented
                    {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_EXPORT', version) %}
                        <a class="ui labeled icon button"
                           href="{{ url('sfs_cms_admin_sections_export_version', {'section':section_entity.id, 'version':version.id}) }}">{{ ('admin_sections.versions.actions.export.link')|trans }}
                            <i class="icon download"></i></a>
                    {% endif %}
                    #}

                    <div class="ui simple dropdown item button" tabindex="0">
                        <span>More</span>
                        <i class="dropdown icon" tabindex="0"><div class="menu" tabindex="-1"></div></i>
                        <div class="menu left transition" tabindex="-1">
                            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_PUBLISH', version) %}
                                {% if not version.published %}
                                    <a class="item"
                                       data-confirm-modal="{{ ('admin_sections.version_publish.confirm_message_raw')|trans|base64_encode }}"
                                       data-confirm-modal-title="{{ ('admin_sections.version_publish.confirm_message_title')|trans }}"
                                       href="{{ url('sfs_cms_admin_sections_publish_version', {'section':section_entity.id, 'version':version.id, 'back': 'version_info'}) }}">{{ ('admin_sections.versions.actions.publish.link')|trans }}</a>
                                {% endif %}
                            {% endif %}
                            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_UNPUBLISH', version) %}
                                {% if version.published %}
                                    <a class="item"
                                       data-confirm-modal="{{ ('admin_sections.version_unpublish.confirm_message_raw')|trans|base64_encode }}"
                                       data-confirm-modal-title="{{ ('admin_sections.version_publish.confirm_message_title')|trans }}"
                                       href="{{ url('sfs_cms_admin_sections_unpublish', {'section':section_entity.id, 'version':version.id, 'back': 'version_info'}) }}">{{ ('admin_sections.versions.actions.unpublish.link')|trans }}</a>
                                {% endif %}
                            {% endif %}
                            {# Uncomment if translations are implemented
                            {# <a class="item disabled">{{ ('admin_sections.tabs_menu.translations')|trans }}</a> #}
                            #}
                            <hr class="ui divider">
                            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_DELETE', version) %}
                                <a class="ui item red header"
                                   href="{{ url('sfs_cms_admin_sections_delete_version', {'section':section_entity.id, 'version':version.id, 'back': 'versions'}) }}">
                                    {{ ('admin_sections.versions.actions.delete.link')|trans }}
                                </a>
                            {% else %}
                                <a class="ui item red header disabled">
                                    {{ ('admin_sections.versions.actions.delete.link')|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endblock actions %}
            </div>
        </div>

        <div class="ui grid">
            <div class="five wide column">
                {% include '@SfsCms/admin/section/_version_info_general.html.twig' %}
                {# Uncomment if linked routes/medias are implemented
                {# {% include '@SfsCms/admin/section/_version_info_linked_routes.html.twig' %} #}
                {# {% include '@SfsCms/admin/section/_version_info_linked_medias.html.twig' %} #}
            </div>
            <div class="eleven wide column">
                {% include '@SfsCms/admin/section/_version_info_compiled.html.twig' %}
                {% include '@SfsCms/admin/section/_version_info_data.html.twig' %}
                {# Uncomment if SEO info is implemented
                {# {% include '@SfsCms/admin/section/_version_info_seo.html.twig' %} #}
            </div>
            <div class="sixteen wide column">
                {# Uncomment if history is implemented
                {# {% include '@SfsCms/admin/section/_version_info_history.html.twig' %} #}
            </div>
        </div>
    </div>
{% endblock content %}
