{% trans_default_domain 'sfs_cms_contents' %}

<section class="ui basic segment" aria-labelledby="content-sites-and-locales-fields-title">
    <h2 class="ui dividing header" id="content-sites-and-locales-fields-title">{{ 'admin_content.form.sections.availability.title'|trans }}</h2>

    {% if form.sites is defined %}
        <div class="{{ form.sites.vars.choices|length < 2 ? 'hidden' : '' }}">
            {{ form_row(form.sites) }}
        </div>
    {% endif %}
    {% if form.defaultLocale is defined and form.locales is defined %}
        <div class="{{ form.defaultLocale.vars.choices|length < 2 ? 'hidden' : '' }}">
            {{ form_row(form.defaultLocale, {'attr': {'data-locale-disables-choice': form.locales.vars.id}}) }}
        </div>
    {% endif %}
    {% if form.locales is defined %}
        <div class="{{ form.locales.vars.choices|length < 2 ? 'hidden' : '' }}">
            {{ form_row(form.locales) }}
        </div>
    {% endif %}
    {% if form.addLocale is defined %}{{ form_row(form.addLocale) }}{% endif %}
</section>
