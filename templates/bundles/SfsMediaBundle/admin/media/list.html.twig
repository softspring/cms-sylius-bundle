{% trans_default_domain 'sfs_media_admin' %}
{% extends '@SfsMedia/admin_layout_semantic.html.twig' %}
{% set sfs_components_theme = 'semantic-ui' %}

{% block title %}{{ 'admin_medias.list.meta.title'|trans }}{% endblock %}
{% block header_title %}{{ 'admin_medias.list.title'|trans }}{% endblock %}
{% block header_subtitle %}Manage content media{% endblock %}
{% block breadcrums_content %}
    <a class="active section">{{ 'admin_medias.list.breadcrumb'|trans }}</a>
{% endblock breadcrums_content %}

{% block header_buttons %}
    {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_CREATE') and media_types|length %}
        <div class="ui floated simple labeled icon dropdown button teal">
            <i class="plus icon"></i>
           {{ 'admin_medias.list.actions.create.link'|trans }}
            <div class="menu">
                {% for key,type in media_types %}
                    <div class="item">
                        <a href="{{ url('sfs_media_admin_medias_create', {'type':key}) }}">{{ type.name }}</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
        <div class="ui hidden divider"></div>
        {% if media_types is empty %}
            <div class="ui segment sylius-grid-table-wrapper">
                <p class="text-center text-muted">
                    No media types are configured.
                    <br/>
                    <br/>
                    Check how to configure media types at <a href="https://github.com/softspring/media-bundle"
                                                             target="_blank">documentation</a>
                </p>
            </div>
        {% else %}

            {% if duplicates.total %}
                <div class="ui warning message" role="alert">
                    {{ 'admin_medias.alerts.total_duplicates_raw'|trans({'%different%': duplicates.different, '%total%': duplicates.total, '%duplicates%': duplicates.total - duplicates.different})|raw }}
                </div>
                {#{{ dump(duplicates) }}#}
            {% endif %}

            {{ form_start(filterForm, {'attr': {'class':'ui form'}}) }}
            <div class="ui segment sylius-grid-table-wrapper">
                <div class="ui grid">
                    <div class="three wide  column" style="border-right: 1px solid #CCC;">
                        {% include '@SfsMedia/admin/media/list-filter-column.html.twig' %}
                    </div>
                    <div class="thirteen wide column">
                        <div class="h-100 overflow-auto">
                            <div class="ui grid">
                                <div class="ten wide column">
                                    {{ entities.total }} medias
                                </div>
                                <div class="three wide column">{{ form_widget(filterForm.order, {'attr': {'onchange': 'submit()', 'class': 'form-control-sm'}}) }}</div>
                                <div class="three wide column">{{ form_widget(filterForm.sort, {'attr': {'onchange': 'submit()', 'class': 'form-control-sm'}}) }}</div>
                            </div>

                            {% if entities|length %}
                                {% include '@SfsMedia/admin/media/list-page.html.twig' %}
                                <div class="ui hidden divider"></div>
                                {% include '@SfsComponents/paginator/pager.html.twig' with {'collection': entities} %}

                            {% else %}
                                <div class="p-5 m-5">
                                    <p class="text-center text-muted">
                                        {% if filterForm|default(false) and filterForm.vars.data|default([])|filter(v=>v) is not empty %}
                                            No search results found, try to be less restrictive.
                                        {% else %}
                                            Upload first media
                                        {% endif %}
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {{ form_end(filterForm) }}
        {% endif %}
{% endblock content %}

{% block javascripts %}
    {{ parent() }}

    <div class="offcanvas offcanvas-end w-75" data-bs-scroll="false" data-bs-backdrop="true" tabindex="-1"
         id="mediaPreview" aria-labelledby="mediaPreviewLabel">
        {#    <div class="offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="mediaPreview" aria-labelledby="mediaPreviewLabel"> #}
        <div class="offcanvas-header">
            <h5 class="offcanvas-title me-auto" id="mediaPreviewLabel">Offcanvas</h5>
            <div class="offcanvas-header-buttons text-right">

            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body"></div>
    </div>

    <script type="text/javascript">

        document.addEventListener('click', function(e) {
            if (!e.target.matches('[data-bulk-select]')) {
                return;
            }

            e.stopPropagation();

            if (e.target.checked) {
                e.target.parentNode.parentNode.classList.add('border-danger');
            } else {
                e.target.parentNode.parentNode.classList.remove('border-danger');
            }
        });
    </script>
{% endblock javascripts %}
