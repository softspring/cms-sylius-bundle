{% trans_default_domain 'sfs_media_admin' %}
{% extends '@SfsMedia/admin_layout_semantic.html.twig' %}
{% block title %}{{ 'admin_medias.read.meta.title'|trans({'%name%': media.name }) }}{% endblock %}

{% block header_title %}{{ 'admin_medias.read.title'|trans({'%name%': media.name }) }}{% endblock %}
{% block header_subtitle %}Manage content media{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <a class="section" href="{{ url('sfs_media_admin_medias_list') }}">{{ 'admin_medias.list.breadcrumb'|trans }}</a><i class="right chevron icon divider"></i>
    <span class="section active" aria-current="content">{{ 'admin_medias.read.breadcrumb'|trans({'%name%': media.name }) }}</span>
{% endblock breadcrums_content %}

{% block content %}

    {% include '@SfsMedia/admin/media/read_version_alerts.html.twig' %}
    <div class="ui segment">
        <div class="ui">
            {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_DELETE', media) %}
                <a href="{{ url('sfs_media_admin_medias_delete', {'media': media}) }}"
                   class="ui right floated button red"><i class="icon trash"></i> {{ 'admin_medias.read.actions.delete.button'|trans }}</a>
            {% else %}
                <a class="ui right floated button red disabled"><i class="icon trash"></i> {{ 'admin_medias.read.actions.delete.button'|trans }}</a>
            {% endif %}
            {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_UPDATE', media) %}
                <a href="{{ url('sfs_media_admin_medias_update', {'media': media}) }}"
                   class="ui right floated button teal"><i class="icon pencil"></i> {{ 'admin_medias.read.actions.update.button'|trans }}</a>
            {% else %}
                <a class="ui right floated button teal disabled"><i class="icon pencil"></i> {{ 'admin_medias.read.actions.update.button'|trans }}</a>
            {% endif %}
            {% if (checkVersions.new|length) + (checkVersions.delete|length) + (checkVersions.changed|length) %}
                {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_MIGRATE', media) %}
                    <a href="{{ url('sfs_media_admin_medias_migrate', {'media': media}) }}"
                       class="ui right floated button teal"><i class="icon pencil"></i> {{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
                {% else %}
                    <a class="ui right floated button teal disabled"><i class="icon pencil"></i> {{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
                {% endif %}
            {% endif %}
            <div class="ui hidden divider"  style="clear: both;"></div>
        </div>

        {% include '@SfsMedia/admin/media/read_tabs.html.twig' %}

        {% include '@SfsMedia/admin/media/read_tabs_content.html.twig' %}

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $('.menu .item').tab();
    </script>
{% endblock %}
